{
    "import": ["@cspell/dict-lorem-ipsum/cspell-ext.json"], // 导入其他词典，这是一个示例，您可以根据需要添加其他词典
    "caseSensitive": false, // 是否区分大小写
    "dictionaries": ["custom-words"], // 使用自定义词典
    "dictionaryDefinitions": [
        {
            "name": "custom-words",
            "path": "./.cspell/custom-words.txt",
            "addWords": true
        }
    ],
    "ignorePaths": [
        "**/node_modules/**",
        "**/dist/**",
        "**/lib/**",
        "**/docs/**",
        "**/stats.html",
        "**/language/**",
        "**/language.ts",
        "**/package.json",
        "eslint.config.js",
        "apps/builder/src/utils/detect.ts",
        "**/MOCK_DATA.ts"
    ]
}
